---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import { SITE } from '../config';
import { filmScenes, demos, effects, steps, craft, addons, faq } from '../data/content';

const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': abs('/#org'),
    name: SITE.name,
    url: abs('/'),
    logo: abs('/apple-touch-icon.png'),
    description: SITE.description,
    ...(SITE.email ? { email: SITE.email } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': abs('/#website'),
    name: SITE.name,
    url: abs('/'),
    inLanguage: 'he-IL',
    publisher: { '@id': abs('/#org') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': abs('/#service'),
    name: 'סרטון גדילה ב-AI',
    serviceType: 'עריכת סרטוני גדילה עם מעברים רציפים',
    description: SITE.description,
    provider: { '@id': abs('/#org') },
    areaServed: { '@type': 'Country', name: 'Israel' },
    availableLanguage: 'he',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'סרטון גדילה לדוגמה של OneStory',
    description: 'קטע מסרטון גדילה: הילדה עוברת מתמונה לתמונה בתנועה רציפה, עם אפקטים וטקסטים מונפשים.',
    thumbnailUrl: abs('/media/film-poster.webp'),
    contentUrl: abs('/media/film.mp4'),
    uploadDate: SITE.filmDate,
    duration: 'PT43S',
    inLanguage: 'he',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const wa = SITE.whatsapp ? `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('היי, אשמח לשמוע על סרטון גדילה')}` : '#contact';
const play = '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l12.5-7.5z"/></svg>';
---

<Base title="OneStory | סרטוני גדילה ב-AI עם מעברים רציפים" description={SITE.description} schema={schema}>
  <header class="site-header" data-header>
    <div class="wrap header-inner">
      <a href="/" class="brand" aria-label="OneStory, לדף הבית"><Wordmark class="brand-mark" /></a>
      <nav class="nav" aria-label="ראשי" id="site-nav" data-nav>
        <a href="#film">הסרטון</a>
        <a href="#demos">המעברים</a>
        <a href="#process">איך זה עובד</a>
        <a href="#scope">מה כלול</a>
        <a href="#faq">שאלות</a>
        <a href="#contact" class="btn btn--light nav-cta">בואו נדבר</a>
      </nav>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
        <span class="visually-hidden">תפריט</span>
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <video
        class="hero-video"
        data-autoplay
        data-always-play
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/media/hero-poster.webp"
        aria-hidden="true"
      >
        <source src="/media/hero-loop.mp4" type="video/mp4" />
      </video>
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="wrap hero-content">
        <p class="eyebrow hero-eyebrow">סרטון גדילה</p>
        <h1 id="hero-title">המעבר הוא כל ההבדל.</h1>
        <p class="hero-lead">
          סרטוני גדילה שבהם הדמות עוברת מתמונה לתמונה בתנועה אחת רציפה, כל מעבר מתוכנן ונערך בהתאמה אישית לתמונות שלכם.
        </p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn--light">בואו נדבר על סרטון הגדילה שלכם</a>
          <a href="#film" class="btn btn--ghost-light"><Fragment set:html={play} />צפו בסרטון לדוגמה</a>
        </div>
        <ul class="hero-facts" aria-label="בקצרה">
          <li>כ-30 תמונות</li>
          <li>3–4 דקות</li>
          <li>כל מעבר מותאם אישית</li>
        </ul>
      </div>
      <button class="hero-pause" type="button" data-hero-pause aria-pressed="false">
        <span class="visually-hidden" data-label>עצירת וידאו הרקע</span>
        <svg class="i-pause" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
        <svg class="i-play" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l12.5-7.5z" /></svg>
      </button>
    </section>

    <!-- Film -->
    <section class="section section--dark" id="film" aria-labelledby="film-title">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">הסרטון</p>
          <h2 id="film-title">ככה זה נראה כשהסיפור לא נעצר.</h2>
          <p>קטע של 43 שניות מתוך סרטון גדילה, עם אפקטים וטקסטים מונפשים. שימו לב למעברים: אין רגע אחד שבו התמונה פשוט מתחלפת.</p>
        </div>
        <div class="film-frame reveal">
          <video controls playsinline preload="none" poster="/media/film-poster.webp" aria-describedby="film-desc">
            <source src="/media/film.mp4" type="video/mp4" />
          </video>
          <p id="film-desc" class="visually-hidden">ילדה עוברת בתנועה רציפה מהחדר עם תיקי בית הספר אל מצוק מול הים, לכותל, לסלפי משפחתי, לטיילת באילת, לצלילה באגם ולפינת חיות.</p>
        </div>

        <div class="story-path reveal" data-story-path data-scenes={JSON.stringify(filmScenes.map((s) => [s.start, s.end]))}>
          <div class="story-head">
            <p class="story-now">
              <span class="story-kind" data-now-kind>התמונות שמאחורי הסרטון</span>
              <span class="story-label-now" data-now-label>{filmScenes.length} תמונות מקוריות, תנועה אחת</span>
            </p>
            <p class="story-hint">לחצו על תמונה כדי לקפוץ אליה בסרטון</p>
          </div>
          <div class="story-scroller">
            <div class="story-inner" style={`--n: ${filmScenes.length}`}>
              <div class="story-rail" aria-hidden="true">
                <span class="story-line"><span class="story-fill" data-story-fill></span></span>
                {filmScenes.map(() => <span class="story-dot"></span>)}
              </div>
              <ol class="story-list">
                {filmScenes.map((s, i) => (
                  <li class="story-item">
                    <button class="story-thumb" type="button" data-seek={s.start} aria-label={`קפיצה לתמונה ${i + 1} בסרטון: ${s.label}`}>
                      <img src={s.thumb} alt="" width="160" height="90" loading="lazy" decoding="async" />
                    </button>
                    <span class="story-name"><span class="story-n" aria-hidden="true">{i + 1}</span>{s.label}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Demos -->
    <section class="section" id="demos" aria-labelledby="demos-title">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">המעברים</p>
          <h2 id="demos-title">שתי תמונות. תנועה אחת.</h2>
          <p>בחרו זוג תמונות וראו את המעבר שנוצר ביניהן. אלה התמונות המקוריות, והקטע לקוח מתוך סרטון הגדילה.</p>
        </div>
        <div class="demos reveal" data-demos>
          <div class="demo-tabs" role="tablist" aria-label="בחירת מעבר">
            {demos.map((d, i) => (
              <button
                class="demo-tab"
                type="button"
                role="tab"
                id={`tab-${d.id}`}
                aria-controls={`panel-${d.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="demo-tab-thumbs" aria-hidden="true">
                  <img src={d.from.src} alt="" width="96" height="54" loading="lazy" decoding="async" />
                  <img src={d.to.src} alt="" width="96" height="54" loading="lazy" decoding="async" />
                </span>
                <span>{d.label}</span>
              </button>
            ))}
          </div>
          {demos.map((d, i) => (
            <div class="demo-panel" role="tabpanel" id={`panel-${d.id}`} aria-labelledby={`tab-${d.id}`} hidden={i !== 0}>
              <div class="demo-photos">
                <figure>
                  <img src={d.from.src} alt={d.from.alt} width="640" height="360" loading="lazy" decoding="async" />
                  <figcaption>תמונה 1</figcaption>
                </figure>
                <svg class="demo-arrow" aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
                <figure>
                  <img src={d.to.src} alt={d.to.alt} width="640" height="360" loading="lazy" decoding="async" />
                  <figcaption>תמונה 2</figcaption>
                </figure>
              </div>
              <figure class="demo-clip">
                <video data-autoplay muted loop playsinline preload="none" aria-label={`המעבר: ${d.label}`}>
                  <source data-src={d.clip} type="video/mp4" />
                </video>
                <figcaption>{d.note}</figcaption>
              </figure>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Compare -->
    <section class="section section--dark" id="compare" aria-labelledby="compare-title">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">ההבדל</p>
          <h2 id="compare-title">דיזולב רגיל מול תנועה אחת.</h2>
          <p>אותן שתי תמונות. מצד אחד מעבר רגיל, שבו תמונה אחת נמוגה לתוך השנייה. מהצד השני, המעבר של OneStory.</p>
        </div>
        <div class="compare reveal" data-compare>
          <figure>
            <video muted loop playsinline preload="none" aria-label="מעבר דיזולב רגיל בין התמונה מול הדגל לתמונה באגם">
              <source data-src="/media/dissolve-flag-lake.mp4" type="video/mp4" />
            </video>
            <figcaption><strong>דיזולב רגיל</strong> התמונה מתחלפת, הסיפור נעצר.</figcaption>
          </figure>
          <figure>
            <video muted loop playsinline preload="none" aria-label="המעבר של OneStory: הילדה צוללת מהמרפסת אל האגם">
              <source data-src="/media/t-flag-lake.mp4" type="video/mp4" />
            </video>
            <figcaption><strong>OneStory</strong> הדמות ממשיכה לנוע, הסיפור ממשיך.</figcaption>
          </figure>
        </div>
        <div class="compare-actions reveal">
          <button class="btn btn--light" type="button" data-compare-play><Fragment set:html={play} /><span data-label>הפעלת ההשוואה</span></button>
        </div>
      </div>
    </section>

    <!-- Craft -->
    <section class="section" id="craft" aria-labelledby="craft-title">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">מאחורי הקלעים</p>
          <h2 id="craft-title">הטכנולוגיה יוצרת תנועה. הבחירות יוצרות סרטון.</h2>
          <p>מערכת אוטומטית מקבלת תמונות ומחזירה תוצאה. כאן כל מעבר עובר דרך עין של עורך וידאו.</p>
        </div>
        <ol class="craft-list">
          {craft.map((c, i) => (
            <li class="craft-item reveal">
              <span class="craft-num" aria-hidden="true">0{i + 1}</span>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Process -->
    <section class="section section--peach" id="process" aria-labelledby="process-title">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">איך זה עובד</p>
          <h2 id="process-title">ארבעה שלבים, סרטון גדילה אחד.</h2>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li class="step reveal">
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Scope -->
    <section class="section" id="scope" aria-labelledby="scope-title">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">מה כלול</p>
          <h2 id="scope-title">סרטון גדילה אישי. היקף שמתאים לסיפור שלכם.</h2>
        </div>
        <div class="scope">
          <div class="scope-main reveal">
            <h3>סרטון הגדילה שלכם</h3>
            <ul class="checks">
              <li>כ-30 תמונות מתקופות שונות</li>
              <li>סרטון של כ-3 עד 4 דקות</li>
              <li>הכנה של כל תמונה ותכנון של כל מעבר</li>
              <li>מעברים רציפים, בלי דיזולב</li>
              <li>בחירת פורמט: 16:9 להקרנה או 9:16 לרשתות</li>
              <li>מוזיקה, עריכה וליטוש סופי</li>
            </ul>
            <p class="scope-price">המחיר נקבע לפי מספר התמונות, הפורמט והתוספות.</p>
            <a href="#contact" class="btn btn--primary">קבלו הצעה לסרטון שלכם</a>
          </div>
          <div class="scope-addons reveal">
            <h3>תוספות לבחירה</h3>
            <ul class="addons">
              {addons.map((a) => (
                <li>
                  <strong>{a.title}</strong>
                  <span>{a.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="effects reveal">
          <h3 class="effects-title">לפני ואחרי: מה תוספת האפקטים עושה</h3>
          <div class="effects-grid">
            {effects.map((e) => (
              <figure class="effect">
                <div class="effect-pair">
                  <img src={e.photo} alt={e.photoAlt} width="640" height="360" loading="lazy" decoding="async" />
                  <video data-autoplay muted loop playsinline preload="none" aria-label={`אחרי: ${e.label}`}>
                    <source data-src={e.clip} type="video/mp4" />
                  </video>
                </div>
                <figcaption><span>התמונה המקורית</span><span>{e.label}</span></figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="section section--dark" id="about" aria-labelledby="about-title">
      <div class="wrap about">
        <div class="section-head reveal">
          <p class="eyebrow">מי עומד מאחורי OneStory</p>
          <h2 id="about-title">סטודיו שעושה דבר אחד: סרטוני גדילה עם מעברים שזורמים.</h2>
        </div>
        <div class="about-text reveal">
          <p>מאחורי כל סרטון של OneStory עומד עורך וידאו מקצועי עם ניסיון בעריכה ובפוסט-פרודקשן. הכלים החדשים מאפשרים תנועה שלא הייתה אפשרית קודם, אבל ההחלטות נשארות של עורך: איזה רגע מחבר לאיזה, לאן הדמות הולכת, ומתי תוצאה טובה מספיק כדי להיכנס לסרטון.</p>
          <p>בגלל זה כל סרטון גדילה נבנה בנפרד, ולא עובר דרך מערכת אוטומטית.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq" aria-labelledby="faq-title">
      <div class="wrap faq-wrap">
        <div class="section-head reveal">
          <p class="eyebrow">שאלות נפוצות</p>
          <h2 id="faq-title">מה שכדאי לדעת לפני שמתחילים.</h2>
        </div>
        <div class="faq">
          {faq.map((f) => (
            <details class="faq-item">
              <summary><h3>{f.q}</h3></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section section--dark" id="contact" aria-labelledby="contact-title">
      <div class="wrap contact">
        <div class="contact-intro reveal">
          <p class="eyebrow">יצירת קשר</p>
          <h2 id="contact-title">בואו נהפוך את התמונות שלכם לתנועה.</h2>
          <p>ספרו לנו על האירוע ועל סרטון הגדילה שאתם מדמיינים. נחזור אליכם כדי לדבר על הכיוון ועל היקף העבודה.</p>
          <p class="contact-privacy">התמונות לא נשלחות בשלב הזה. אוספים אותן רק אחרי שיחה, בדרך פרטית.</p>
        </div>
        <form class="contact-form reveal" data-contact novalidate>
          <div class="field">
            <label for="c-name">שם</label>
            <input id="c-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="c-phone">טלפון</label>
            <input id="c-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" required aria-describedby="c-phone-hint" />
            <small id="c-phone-hint">נחזור אליכם בטלפון או ב-WhatsApp.</small>
          </div>
          <div class="field">
            <label for="c-type">סוג האירוע</label>
            <select id="c-type" name="type">
              <option>בר מצווה</option>
              <option>בת מצווה</option>
              <option>יום הולדת</option>
              <option>חתונה</option>
              <option>אחר</option>
            </select>
          </div>
          <div class="field">
            <label for="c-date">מועד האירוע <span class="optional">(לא חובה)</span></label>
            <input id="c-date" name="date" type="text" placeholder="למשל: מרץ 2027" />
          </div>
          <div class="field field--full">
            <label for="c-notes">כמה מילים על הסרטון <span class="optional">(לא חובה)</span></label>
            <textarea id="c-notes" name="notes" rows="4"></textarea>
          </div>
          <div class="form-actions field--full">
            <button class="btn btn--light" type="submit">שליחה</button>
            {SITE.whatsapp && <a class="btn btn--ghost-light" href={wa} rel="noopener">WhatsApp</a>}
          </div>
          <p class="form-status field--full" role="status" aria-live="polite" data-status></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <Wordmark class="footer-mark" />
      <p>{SITE.tagline}</p>
      <p class="footer-small">© {new Date().getFullYear()} OneStory. כל הזכויות שמורות.</p>
    </div>
  </footer>

  <div class="mobile-cta" data-mobile-cta>
    <a href="#contact" class="btn btn--light">בואו נדבר על הסרטון</a>
    {SITE.whatsapp && (
      <a href={wa} class="btn btn--ghost-light mobile-wa" aria-label="שליחת הודעה ב-WhatsApp" rel="noopener">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.6-5.2A8.5 8.5 0 1 1 21 11.5z" /></svg>
      </a>
    )}
  </div>

  <script>
    import { init } from '../scripts/site';
    init();
  </script>
</Base>

<style>
  /* Header */
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    color: var(--cream);
    transition: background-color 250ms var(--ease-out), box-shadow 250ms var(--ease-out);
  }
  .site-header.is-solid {
    background: rgba(18, 21, 27, 0.94);
    box-shadow: 0 1px 0 rgba(250, 246, 239, 0.08);
  }
  @supports (backdrop-filter: blur(8px)) {
    .site-header.is-solid {
      background: rgba(18, 21, 27, 0.82);
      backdrop-filter: blur(10px);
    }
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 80px;
  }
  .brand {
    color: var(--cream);
    display: inline-flex;
    padding-block: 8px;
  }
  .brand :global(.brand-mark) {
    height: 34px;
    width: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.4vw, 36px);
    font-weight: 600;
  }
  .nav a:not(.btn) {
    color: var(--cream);
    text-decoration: none;
    padding-block: 10px;
  }
  .nav a:not(.btn):hover {
    color: var(--gold-light);
  }
  .nav-cta {
    min-height: 46px;
    padding-inline: 22px;
    font-size: 1rem;
  }
  .nav-toggle {
    display: none;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 14px;
    background: rgba(250, 246, 239, 0.12);
    color: var(--cream);
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .nav-toggle {
      display: inline-flex;
    }
    .nav {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 24px;
      background: var(--cinema);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.25);
      display: none;
    }
    .nav.is-open {
      display: flex;
    }
    .nav a:not(.btn) {
      padding-block: 14px;
      border-bottom: 1px solid rgba(250, 246, 239, 0.1);
      font-size: 1.15rem;
    }
    .nav-cta {
      margin-top: 16px;
      min-height: 52px;
    }
    .brand :global(.brand-mark) {
      height: 28px;
    }
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    background: var(--cinema);
    color: var(--cream);
    overflow: hidden;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(18, 21, 27, 0.78) 0, rgba(18, 21, 27, 0) 200px),
      linear-gradient(270deg, rgba(18, 21, 27, 0.88) 0%, rgba(18, 21, 27, 0.6) 45%, rgba(18, 21, 27, 0.1) 80%),
      linear-gradient(0deg, rgba(18, 21, 27, 0.7) 0%, rgba(18, 21, 27, 0) 40%);
  }
  .hero-content {
    position: relative;
    padding-top: 140px;
    padding-bottom: clamp(40px, 6vh, 72px);
    display: grid;
    gap: 22px;
  }
  .hero-content .eyebrow {
    color: var(--gold-light);
  }
  .hero-eyebrow {
    font-size: 1.15rem;
    letter-spacing: 0.01em;
  }
  @media (min-width: 901px) {
    .hero-eyebrow {
      font-size: 1.75rem;
      margin-bottom: -10px;
    }
  }
  #film {
    padding-top: clamp(40px, 5vw, 72px);
  }
  .hero h1 {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 1.04;
    max-width: 12em;
  }
  .hero-lead {
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    color: var(--cinema-text);
    max-width: 34em;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 6px;
  }
  .hero-facts {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    color: var(--cinema-text);
    font-size: 1.05rem;
  }
  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .hero-facts li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold-light);
  }
  .hero-pause {
    position: absolute;
    bottom: 24px;
    inset-inline-end: var(--gutter);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(250, 246, 239, 0.4);
    background: rgba(18, 21, 27, 0.5);
    color: var(--cream);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .hero-pause .i-play {
    display: none;
  }
  .hero-pause[aria-pressed='true'] .i-play {
    display: block;
  }
  .hero-pause[aria-pressed='true'] .i-pause {
    display: none;
  }

  @media (max-width: 700px) {
    .hero {
      align-items: stretch;
      flex-direction: column;
    }
    .hero-video {
      position: relative;
      height: 52svh;
      object-position: 55% center;
    }
    .hero-scrim {
      height: 52svh;
      background: linear-gradient(180deg, rgba(18, 21, 27, 0.55) 0%, rgba(18, 21, 27, 0) 28%, rgba(18, 21, 27, 0) 60%, rgba(18, 21, 27, 1) 100%);
    }
    .hero-content {
      padding-top: 0;
      margin-top: -64px;
      padding-bottom: 48px;
      gap: 16px;
    }
    .hero-actions .btn {
      flex: 1 1 100%;
    }
    .hero-actions .btn--light {
      display: none;
    }
    .hero-pause {
      top: 92px;
      bottom: auto;
    }
  }

  /* Film */
  .film-frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(250, 246, 239, 0.08);
  }
  .film-frame video {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  /* Story path under the film */
  .story-path {
    margin-top: 28px;
    display: grid;
    gap: 18px;
  }
  .story-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 24px;
  }
  .story-now {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    min-height: 2.2em;
  }
  .story-kind {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--gold-light);
  }
  .story-label-now {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: var(--cream);
  }
  .story-hint {
    font-size: 0.95rem;
    color: #c9c2b6;
  }
  .story-scroller {
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 6px;
  }
  .story-inner {
    min-width: 760px;
    display: grid;
    gap: 14px;
  }
  .story-rail,
  .story-list {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 12px;
  }
  .story-rail {
    position: relative;
    height: 14px;
    align-items: center;
    justify-items: center;
  }
  /* The line runs from the first dot's centre to the last one's. */
  .story-line {
    position: absolute;
    inset-inline: calc((100% - (var(--n) - 1) * 12px) / var(--n) / 2);
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
    background: rgba(250, 246, 239, 0.18);
    border-radius: 2px;
  }
  .story-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 0;
    background: var(--gold-light);
    border-radius: 2px;
    box-shadow: 0 0 12px rgba(217, 168, 78, 0.6);
  }
  .story-dot {
    position: relative;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--cinema);
    border: 2px solid rgba(250, 246, 239, 0.35);
    transition: background-color 250ms var(--ease-out), border-color 250ms var(--ease-out), transform 250ms var(--ease-out);
  }
  .story-dot.is-done {
    background: var(--gold-light);
    border-color: var(--gold-light);
  }
  .story-dot.is-current {
    background: var(--gold-light);
    border-color: var(--cream);
    transform: scale(1.35);
  }
  .story-dot.is-next {
    border-color: var(--gold-light);
  }
  .story-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .story-item {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .story-thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: none;
    cursor: pointer;
    outline-offset: 3px;
    position: relative;
    transition: transform 300ms var(--ease-out);
  }
  .story-thumb img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
    opacity: 0.55;
    filter: saturate(0.6);
    transition: opacity 300ms var(--ease-out), filter 300ms var(--ease-out);
  }
  .story-thumb::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 15px;
    border: 2px solid transparent;
    transition: border-color 250ms var(--ease-out);
    pointer-events: none;
  }
  .story-thumb:hover img {
    opacity: 0.85;
  }
  .story-item.is-done .story-thumb img {
    opacity: 0.8;
    filter: none;
  }
  .story-item.is-current .story-thumb {
    transform: translateY(-4px);
  }
  .story-item.is-current .story-thumb img,
  .story-item.is-next .story-thumb img {
    opacity: 1;
    filter: none;
  }
  .story-item.is-current .story-thumb::after {
    border-color: var(--gold-light);
  }
  .story-item.is-next .story-thumb::after {
    border-color: rgba(217, 168, 78, 0.55);
    border-style: dashed;
  }
  .story-name {
    display: flex;
    gap: 6px;
    align-items: baseline;
    font-size: 0.95rem;
    line-height: 1.35;
    color: #c9c2b6;
  }
  .story-n {
    font-weight: 700;
    color: var(--gold-light);
    font-variant-numeric: tabular-nums;
  }
  .story-item.is-current .story-name,
  .story-item.is-next .story-name {
    color: var(--cream);
  }

  /* Demos */
  .demo-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }
  .demo-tab {
    display: grid;
    gap: 10px;
    justify-items: start;
    padding: 12px;
    border-radius: 16px;
    border: 2px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    font-size: 1rem;
    text-align: start;
    cursor: pointer;
    transition: border-color 200ms var(--ease-out), background-color 200ms var(--ease-out);
  }
  .demo-tab:hover {
    border-color: var(--gold-light);
  }
  .demo-tab[aria-selected='true'] {
    border-color: var(--gold);
    background: #fffaf2;
  }
  .demo-tab-thumbs {
    display: flex;
    gap: 6px;
    width: 100%;
  }
  .demo-tab-thumbs img {
    flex: 1 1 0;
    min-width: 0;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    border-radius: 8px;
  }
  .demo-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    gap: 24px;
    align-items: start;
  }
  .demo-panel[hidden] {
    display: none;
  }
  .demo-photos {
    display: grid;
    gap: 10px;
    justify-items: center;
  }
  .demo-photos figure,
  .demo-clip {
    margin: 0;
    width: 100%;
  }
  .demo-photos img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 14px;
  }
  .demo-photos figcaption,
  .demo-clip figcaption {
    font-size: 0.95rem;
    color: var(--muted);
    margin-top: 6px;
  }
  .demo-arrow {
    color: var(--gold);
    transform: rotate(-90deg);
  }
  .demo-clip video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--cinema);
  }
  .demo-clip figcaption {
    font-size: 1.05rem;
    color: var(--ink);
    margin-top: 12px;
  }

  @media (max-width: 900px) {
    .demo-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .demo-panel {
      grid-template-columns: minmax(0, 1fr);
    }
    .demo-clip {
      order: -1;
    }
    .demo-photos {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
    }
    .demo-arrow {
      transform: none;
    }
  }

  /* Compare */
  .compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .compare figure {
    margin: 0;
  }
  .compare video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    background: #000;
  }
  .compare figcaption {
    margin-top: 12px;
    color: var(--cinema-text);
  }
  .compare figcaption strong {
    display: block;
    color: var(--cream);
    font-family: var(--font-head);
    font-size: 1.3rem;
  }
  .compare figure:last-child figcaption strong {
    color: var(--gold-light);
  }
  .compare-actions {
    margin-top: 28px;
  }
  @media (max-width: 700px) {
    .compare {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Craft */
  .craft-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }
  .craft-item {
    display: grid;
    gap: 12px;
    align-content: start;
    padding-top: 24px;
    border-top: 2px solid var(--ink);
  }
  .craft-num {
    font-family: var(--font-head);
    font-weight: 800;
    color: var(--gold);
    font-size: 1rem;
  }
  .craft-item p {
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .craft-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Process */
  .section--peach {
    background: var(--peach);
  }
  .section--peach .section-head p {
    color: var(--ink);
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .step {
    background: var(--cream);
    border-radius: var(--radius);
    padding: 28px;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .step-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-head);
    font-weight: 800;
    margin-bottom: 6px;
  }
  .step p {
    color: var(--muted);
    font-size: 1.05rem;
  }
  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Scope */
  .scope {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
  }
  .scope-main,
  .scope-addons {
    border-radius: var(--radius-lg);
    padding: clamp(28px, 4vw, 48px);
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .scope-main {
    background: var(--paper);
    border: 2px solid var(--gold);
  }
  .scope-addons {
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .scope h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 800;
  }
  .checks,
  .addons {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .checks li {
    display: flex;
    gap: 12px;
    align-items: baseline;
  }
  .checks li::before {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gold);
    transform: translateY(-2px);
  }
  .addons li {
    display: grid;
    gap: 2px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .addons li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .addons span {
    color: var(--muted);
    font-size: 1.05rem;
  }
  .scope-price {
    color: var(--muted);
  }
  .scope-main .btn {
    justify-self: start;
  }
  .effects {
    margin-top: clamp(48px, 6vw, 80px);
  }
  .effects-title {
    margin-bottom: 20px;
  }
  .effects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .effect {
    margin: 0;
  }
  .effect-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 6px;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .effect-pair img,
  .effect-pair video {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--cinema);
  }
  .effect figcaption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 6px;
    margin-top: 8px;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .effect figcaption span:last-child {
    color: var(--ink);
    font-weight: 700;
  }
  @media (max-width: 900px) {
    .scope {
      grid-template-columns: minmax(0, 1fr);
    }
    .effects-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: start;
  }
  .about .section-head {
    margin-bottom: 0;
  }
  .about-text {
    display: grid;
    gap: 18px;
    font-size: clamp(1.1rem, 1.5vw, 1.25rem);
    color: var(--cinema-text);
  }
  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* FAQ */
  .faq-wrap {
    max-width: calc(960px + 2 * var(--gutter));
  }
  .faq {
    border-top: 1px solid var(--line);
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
  }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '';
    flex: none;
    width: 14px;
    height: 14px;
    border-inline-end: 2.5px solid var(--gold);
    border-bottom: 2.5px solid var(--gold);
    transform: rotate(45deg) translateY(-4px);
    transition: transform 200ms var(--ease-out);
  }
  .faq-item[open] summary::after {
    transform: rotate(-135deg) translateY(-2px);
  }
  .faq-item h3 {
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
  }
  .faq-item p {
    padding-bottom: 24px;
    color: var(--muted);
    max-width: 46em;
  }

  /* Contact */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .contact-intro {
    display: grid;
    gap: 18px;
  }
  .contact-intro p {
    color: var(--cinema-text);
    font-size: 1.2rem;
  }
  .contact-intro .contact-privacy {
    font-size: 1rem;
    color: #c9c2b6;
  }
  .contact-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    background: rgba(250, 246, 239, 0.05);
    border: 1px solid rgba(250, 246, 239, 0.12);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 3vw, 40px);
  }
  .field {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field label {
    font-weight: 700;
  }
  .optional {
    font-weight: 400;
    color: #c9c2b6;
